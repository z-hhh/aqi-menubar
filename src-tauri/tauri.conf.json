{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AQI Menubar",
  "version": "0.2.1",
  "identifier": "app.aqimenubar.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AQI Menubar",
        "width": 340,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Air quality in your menu bar",
    "longDescription": "Shows the live Air Quality Index from aqicn.org in the macOS menu bar or the Windows system tray. Bring your own aqicn API token; no server, no telemetry.",
    "copyright": "MIT licensed",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/z-hhh/aqi-menubar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENzg4MjE2REMzNkQxMzIKUldReTBUYmNGb0o0blU2SVdTNFNGV2lPaGdyaXF3dytBb0QxTWJ6anUwVndEWm9zMEVmUThTZVgK"
    }
  }
}
